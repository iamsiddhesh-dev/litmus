#!/usr/bin/env python3
"""Standalone reproduction for __FINDING_ID__ (__KIND__).

Generated by Litmus. Requires Python 3.9+, adb on PATH, and the app installed
on the target device. Only the standard library and adb are used.

    python repro.py --serial emulator-5554

Exit code 0: the finding reproduced. 1: it did not.

The check at the end depends on the finding kind:

* crash / anr   - the same fingerprint appears in the logcat buffers;
* http_5xx/4xx  - the app logs ``<status> <METHOD> <path>`` after the trigger;
* deadtap       - navigation, screen content and the tapped node stay identical;
* ui_broken     - the same overlap / zero-size / clipped signature is on screen.
"""

import argparse
import hashlib
import json
import re
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

FINDING_ID = __FINDING_ID__
KIND = __KIND__
SIGNATURE = __SIGNATURE__
PACKAGE = __PACKAGE__
COMPONENT = __COMPONENT__
FINGERPRINT = __FINGERPRINT__
SETTLE_MS = __SETTLE_MS__
DENSITY = __DENSITY__
PROBE = json.loads(r"""
__PROBE__
""")
TRACE = json.loads(r"""
__TRACE__
""")

BOUNDS_RE = re.compile(r"\[(-?\d+),(-?\d+)\]\[(-?\d+),(-?\d+)\]")
ADB = "adb"
SERIAL = ""


def adb(*args, timeout=60, binary=False):
    command = [ADB]
    if SERIAL:
        command += ["-s", SERIAL]
    command += list(args)
    result = subprocess.run(command, capture_output=True, timeout=timeout)
    if binary:
        return result.stdout
    return result.stdout.decode("utf-8", "replace")


def shell(*args, timeout=60):
    return adb("shell", *args, timeout=timeout)


def screen_size():
    match = re.search(r"(\d+)x(\d+)", shell("wm", "size"))
    return (int(match.group(1)), int(match.group(2))) if match else (720, 1280)


def dump():
    shell("uiautomator", "dump", "/sdcard/litmus_repro.xml", timeout=30)
    xml = adb("exec-out", "cat", "/sdcard/litmus_repro.xml", timeout=30)
    if "<hierarchy" not in xml:
        return None
    try:
        return ET.fromstring(xml)
    except ET.ParseError:
        return None


def walk(root):
    entries = []

    def visit(element, depth, index, path):
        entries.append((element, depth, index, path))
        for child_index, child in enumerate(list(element)):
            if child.tag != "node":
                continue
            child_path = path + "/" + child.get("class", "?") + "[" + str(child_index) + "]"
            visit(child, depth + 1, child_index, child_path)

    for root_index, element in enumerate(child for child in list(root) if child.tag == "node"):
        visit(element, 0, 0, "#" + str(root_index))
    return entries


def app_entries(root):
    return [entry for entry in walk(root) if entry[0].get("package") == PACKAGE]


def state_hash(root):
    app = app_entries(root)
    scoped = sorted(
        {
            entry[0].get("resource-id")
            for entry in app
            if entry[0].get("resource-id")
            and entry[0].get("resource-id").startswith(PACKAGE + ":id/")
        }
    )
    if scoped:
        ids = scoped
    else:
        ids = sorted({entry[0].get("resource-id") for entry in app if entry[0].get("resource-id")})
    density = (
        sum(1 for entry in app if entry[0].get("resource-id")) / len(app) if app else 0.0
    )
    weak = ""
    if density < 0.15:
        parts = []
        for element, depth, index, _path in app:
            if element.get("resource-id"):
                continue
            match = BOUNDS_RE.match(element.get("bounds", ""))
            bucket = ""
            if match:
                left, top, right, bottom = (int(value) for value in match.groups())
                bucket = "{},{},{},{}".format(
                    left // 40, top // 40, right // 40, bottom // 40
                )
            parts.append(
                "{}:{}:{}:{}:{}".format(
                    element.get("class", ""),
                    depth,
                    index,
                    bucket,
                    element.get("content-desc", ""),
                )
            )
        weak = "|".join(parts)
    payload = PACKAGE + "|" + ",".join(ids) + "|" + weak
    return hashlib.sha1(payload.encode("utf-8")).hexdigest()


def node_content(element):
    return "|".join(
        [
            (element.get("text") or "").strip(),
            (element.get("content-desc") or "").strip(),
            "1" if element.get("checked") == "true" else "0",
            "1" if element.get("selected") == "true" else "0",
            "1" if element.get("enabled") == "true" else "0",
        ]
    )


def content_hash(text):
    return hashlib.sha1(text.encode("utf-8")).hexdigest()


def screen_content_hash(root):
    return content_hash("\n".join(
        (element.get("resource-id") or "") + "|" + node_content(element)
        for element, _depth, _index, _path in app_entries(root)
    ))


def bounds_of(element):
    match = BOUNDS_RE.match(element.get("bounds", "") or "")
    if not match:
        return None
    return tuple(int(value) for value in match.groups())


def short_rid(element):
    return (element.get("resource-id") or "").rsplit("/", 1)[-1]


def find_short(root, rid):
    for element, _depth, _index, _path in app_entries(root):
        if short_rid(element) == rid:
            return element
    return None


def resolve(root, selectors, size):
    entries = walk(root)
    width, height = size
    for selector in selectors:
        level = selector.get("level")
        value = selector.get("value")
        occurrence = int(selector.get("occurrence", 0) or 0)
        matches = []
        for element, _depth, _index, path in entries:
            if level == "resource_id" and element.get("resource-id") == value:
                matches.append(element)
            elif level == "content_desc" and element.get("content-desc") == value:
                matches.append(element)
            elif level == "text" and element.get("text") == value:
                matches.append(element)
            elif level == "path" and path == value:
                matches.append(element)
            elif level == "bounds" and isinstance(value, list):
                match = BOUNDS_RE.match(element.get("bounds", ""))
                if not match:
                    continue
                left, top, right, bottom = (int(item) for item in match.groups())
                center_x, center_y = (left + right) // 2, (top + bottom) // 2
                target_x = (value[0] + value[2]) // 2
                target_y = (value[1] + value[3]) // 2
                if (
                    abs(center_x - target_x) <= max(8, int(width * 0.05))
                    and abs(center_y - target_y) <= max(8, int(height * 0.05))
                ):
                    matches.append(element)
        if matches:
            return matches[min(occurrence, len(matches) - 1)]
    return None


def center(element):
    left, top, right, bottom = bounds_of(element)
    return (left + right) // 2, (top + bottom) // 2


def tap(element):
    x, y = center(element)
    shell("input", "tap", str(x), str(y))


def input_text(value):
    escaped = value.replace(" ", "%s").replace("'", "'\\''")
    shell("input", "text", "'" + escaped + "'")


def ime_shown():
    match = re.search(r"mInputShown=(\w+)", shell("dumpsys", "input_method"))
    return bool(match and match.group(1) == "true")


def hide_ime(force=False):
    if ime_shown() or force:
        shell("input", "keyevent", "4")
        time.sleep(0.5)


def execute(step, element, size):
    action = step["action"]
    kind = action["kind"]
    if kind == "tap":
        tap(element)
    elif kind == "input":
        tap(element)
        input_text(action.get("text") or "")
    elif kind == "hide_ime":
        hide_ime(bool(action.get("force")))
    elif kind == "key":
        shell("input", "keyevent", str(action.get("keycode") or "4"))
    elif kind == "scroll":
        width, height = size
        shell(
            "input",
            "swipe",
            str(width // 2),
            str(int(height * 0.72)),
            str(width // 2),
            str(int(height * 0.35)),
        )
    elif kind == "launch":
        shell("am", "force-stop", PACKAGE)
        shell("am", "start", "-W", "-n", COMPONENT)


def crash_fingerprints(log):
    """All (exception + top app frame) fingerprints in a crash buffer."""
    blocks = []
    current = None
    for raw in log.splitlines():
        match = re.search(r"AndroidRuntime[^:]*:\s?(.*)$", raw)
        line = (match.group(1) if match else raw).rstrip()
        if "FATAL EXCEPTION" in line:
            current = []
            blocks.append(current)
        elif current is not None and line.strip():
            current.append(line)
    fingerprints = []
    for block in blocks:
        process = ""
        exception = ""
        frames = []
        for line in block:
            text = line.strip()
            match = re.search(r"Process:\s*([\w.]+),\s*PID:\s*(\d+)", text)
            if match:
                process = match.group(1)
                continue
            match = re.match(r"at\s+([\w$.]+)\.([\w$<>]+)\(", text)
            if match:
                frames.append((match.group(1), match.group(2)))
                continue
            if not exception and not text.startswith(("at ", "Caused by:")):
                match = re.match(
                    r"([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)+)(?::\s*(.*))?$", text
                )
                if match:
                    exception = match.group(1)
        app_frames = [frame for frame in frames if frame[0].startswith(PACKAGE + ".")]
        if not app_frames and process != PACKAGE:
            continue
        if app_frames:
            fingerprints.append(exception + "@" + app_frames[0][0] + "." + app_frames[0][1])
        else:
            fingerprints.append(exception)
    return fingerprints


def crash_log():
    return adb("logcat", "-b", "crash", "-d", "-v", "threadtime")


def main_log():
    return adb("logcat", "-b", "main", "-d", "-v", "brief")


def wait_for_hash(expected, timeout_ms):
    deadline = time.time() + timeout_ms / 1000.0
    while time.time() < deadline:
        root = dump()
        if root is not None and state_hash(root) == expected:
            return True
        time.sleep(0.2)
    return False


def wait_for_crash(timeout_ms):
    deadline = time.time() + timeout_ms / 1000.0
    while time.time() < deadline:
        log = crash_log()
        if FINGERPRINT in crash_fingerprints(log):
            return True
        if KIND == "anr" and "ANR in " + PACKAGE in main_log():
            return True
        time.sleep(0.25)
    return False


def wait_for_http(timeout_ms):
    """The app logs ``<status> <METHOD> <path>`` for every call (contract §3.1)."""
    wanted = PROBE.get("signature", SIGNATURE)
    deadline = time.time() + timeout_ms / 1000.0
    while time.time() < deadline:
        if wanted in main_log():
            return True
        time.sleep(0.25)
    return False


def wait_for_deadtap(timeout_ms):
    expected = PROBE.get("nav_hash", "")
    screen_expected = PROBE.get("screen_hash", "")
    content_expected = PROBE.get("content_hash", "")
    rid = PROBE.get("rid", "")
    deadline = time.time() + timeout_ms / 1000.0
    while time.time() < deadline:
        if ime_shown():
            return False
        root = dump()
        if root is None:
            return False
        if expected and state_hash(root) != expected:
            return False
        if screen_expected and screen_content_hash(root) != screen_expected:
            return False
        element = find_short(root, rid)
        if element is None:
            return False
        if content_expected and content_hash(node_content(element)) != content_expected:
            return False
        time.sleep(0.2)
    return True


def wait_for_ui(timeout_ms):
    """Look for the recorded layout signature on the current screen."""
    deadline = time.time() + timeout_ms / 1000.0
    while time.time() < deadline:
        root = dump()
        if root is not None and ui_signature_present(root):
            return True
        time.sleep(0.2)
    return False


def ui_signature_present(root):
    signature = PROBE.get("signature", SIGNATURE)
    kind, _, value = signature.partition(":")
    if kind == "overlap":
        left_rid, _, right_rid = value.partition(",")
        first, second = find_short(root, left_rid), find_short(root, right_rid)
        if first is None or second is None:
            return False
        a, b = bounds_of(first), bounds_of(second)
        if a is None or b is None:
            return False
        width = min(a[2], b[2]) - max(a[0], b[0])
        height = min(a[3], b[3]) - max(a[1], b[1])
        overlap = max(0, width) * max(0, height)
        return overlap > 8.0 * DENSITY * DENSITY
    if kind == "zero-size":
        element = find_short(root, value)
        bounds = bounds_of(element) if element is not None else None
        return element is not None and bounds is not None and (
            (bounds[2] - bounds[0]) * (bounds[3] - bounds[1]) == 0
        )
    if kind == "clipped":
        element = find_short(root, value)
        bounds = bounds_of(element) if element is not None else None
        if bounds is None:
            return False
        width, height = screen_size()
        tolerance = int(round(2 * DENSITY))
        return (
            bounds[0] < -tolerance
            or bounds[1] < -tolerance
            or bounds[2] > width + tolerance
            or bounds[3] > height + tolerance
        )
    return False


def main():
    global SERIAL
    parser = argparse.ArgumentParser(description="Reproduce " + FINDING_ID)
    parser.add_argument("--serial", default="emulator-5554")
    parser.add_argument("--no-clear", action="store_true", help="do not pm clear the app")
    args = parser.parse_args()
    SERIAL = args.serial

    state = adb("get-state").strip()
    if state != "device":
        print("FAIL: device {} is {}".format(SERIAL, state or "not attached"))
        return 1

    print("reproducing {}: {}".format(FINDING_ID, SIGNATURE))
    shell("logcat", "-b", "crash", "-c")
    if not args.no_clear:
        shell("pm", "clear", PACKAGE)
    shell("am", "force-stop", PACKAGE)
    shell("am", "start", "-W", "-n", COMPONENT)
    size = screen_size()

    start_hash = TRACE[0]["state_before"] if TRACE else PROBE.get("start_hash", "")
    if start_hash and not wait_for_hash(start_hash, 12000):
        print("FAIL: app did not reach the recorded start screen")
        return 1

    last = len(TRACE) - 1
    for index, step in enumerate(TRACE):
        root = dump()
        if root is None:
            print("FAIL: step {}: empty hierarchy".format(index))
            return 1
        element = None
        if step["action"]["kind"] in ("tap", "input"):
            element = resolve(root, step["action"]["selectors"], size)
            if element is None:
                print("FAIL: step {}: selector not found".format(index))
                return 1
        execute(step, element, size)
        if index == last:
            break
        if not wait_for_hash(step["state_after"], SETTLE_MS):
            print("WARN: step {}: navigation hash did not settle".format(index))

    if KIND in ("http_5xx", "http_4xx"):
        reproduced = wait_for_http(SETTLE_MS)
    elif KIND == "deadtap":
        reproduced = wait_for_deadtap(SETTLE_MS)
    elif KIND == "ui_broken":
        reproduced = wait_for_ui(SETTLE_MS)
    else:
        reproduced = wait_for_crash(SETTLE_MS)

    with open("repro_logcat.txt", "w", encoding="utf-8") as handle:
        handle.write(crash_log())
    with open("repro_logcat_main.txt", "w", encoding="utf-8") as handle:
        handle.write(main_log())

    if reproduced:
        print("PASS: {} in {}".format(SIGNATURE, PACKAGE))
        return 0
    print("FAIL: signature not observed within {} ms".format(SETTLE_MS))
    return 1


if __name__ == "__main__":
    sys.exit(main())
