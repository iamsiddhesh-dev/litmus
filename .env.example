# ---------------------------------------------------------------------------
# Litmus environment. Copy to .env and fill in. Never commit .env.
# Every variable here is read by litmus/config.py; nothing is aspirational.
# ---------------------------------------------------------------------------

# Postgres (required only for the control plane: dashboard, REST, history).
# Supabase: use the SESSION pooler URL (:5432), not transaction mode (:6543).
# A CLI run works without this - evidence is written to disk either way.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pass>@<host>:5432/postgres

# Redis (optional): with it, runs are dispatched through Arq. Without it the
# API executes one lifecycle in-process.
REDIS_URL=redis://127.0.0.1:6379

# Model providers (optional; the crawler is heuristic-first and needs no key).
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Android / emulator
LITMUS_AVD=pricebook_avd
ANDROID_HOME=C:\Users\Siddhesh\AppData\Local\Android\Sdk
ANDROID_SDK_ROOT=C:\Users\Siddhesh\AppData\Local\Android\Sdk

# Runtime (ARTIFACTS_DIR defaults to <repo>/artifacts when unset)
ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO

# Control plane: loopback only (single tenant, no auth).
API_HOST=127.0.0.1
API_PORT=8000
# Shared secret for the REST/MCP surface; empty means no auth (loopback only).
API_TOKEN=

# Slack notification when a run finishes (optional; no-op when empty).
SLACK_WEBHOOK_URL=
