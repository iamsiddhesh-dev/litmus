# ---------------------------------------------------------------------------
# Litmus environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Supabase Postgres — use the SESSION pooler URL (:5432), not transaction mode (:6543).
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pass>@<host>:5432/postgres

# Upstash Redis (or a local redis:// for dev).
REDIS_URL=redis://127.0.0.1:6379

# Model providers (optional; the platform runs heuristic-first).
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Android / emulator
LITMUS_AVD=pricebook_avd
ANDROID_HOME=C:\Users\Siddhesh\AppData\Local\Android\Sdk
ANDROID_SDK_ROOT=C:\Users\Siddhesh\AppData\Local\Android\Sdk

# Runtime
LITMUS_ARTIFACTS_DIR=./artifacts
RUNNER_KIND=local_avd
API_TOKEN=
LOG_LEVEL=INFO
# Control plane: loopback only (single tenant, no auth).
API_HOST=127.0.0.1
API_PORT=8000

# Integrations (optional, all no-op when absent)
SLACK_WEBHOOK_URL=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
